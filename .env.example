# Where the enquiry form (demo requests and questions) sends enquiries (required for the forms to deliver).
# Any service that accepts a JSON POST works: a CRM, Zapier/Make, a Slack or Teams incoming webhook, ...
ENQUIRY_WEBHOOK_URL=

# Optional: shows a direct email address on the enquiry page when a visitor chooses "I have a question".
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Admin area (/admin): the enquiry inbox ---------------------------------------------------------
# Optional: the starting password for /admin. Without it the starting password is 123456. Change it on the Admin > Account tab; once changed there, the saved one is used instead.
ADMIN_PASSWORD=
# Optional: a separate secret for signing the admin login cookie (without it a random secret is kept in the database).
ADMIN_SESSION_SECRET=

# --- Email: the confirmation of a booked demo slot goes to the team and to the visitor ----------------
# The details of any mailbox that can send mail (Zoho, Google Workspace, the hosting company's mail). Without them no email is sent;
# bookings are still saved and appear in the admin.
SMTP_HOST=
# 465 for a secure connection, 587 otherwise
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: the address mail is sent from (default: SMTP_USER)
MAIL_FROM=
# Optional: where the team's copy goes (default: info@kyozon.in, the contact address on the site)
ADMIN_NOTIFY_EMAIL=

# Where enquiries and the admin settings are saved when the site is deployed (Vercel has no writable disk).
# Create a free Upstash Redis database (Vercel > Storage > Marketplace > Upstash Redis) and copy its REST URL and token here.
# The names KV_REST_API_URL / KV_REST_API_TOKEN that Vercel adds are understood as well.
# Locally, with neither set, everything is saved to .data/fen1.json instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
