# Where the enquiry form (demo requests and questions) sends enquiries (required for the forms to deliver).
# Any service that accepts a JSON POST works: a CRM, Zapier/Make, a Slack or Teams incoming webhook, ...
ENQUIRY_WEBHOOK_URL=

# Optional: shows a direct email address on the enquiry page when a visitor chooses "I have a question".
NEXT_PUBLIC_CONTACT_EMAIL=
