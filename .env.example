# Where the enquiry form (demo requests and questions) sends enquiries (required for the forms to deliver).
# Any service that accepts a JSON POST works: a CRM, Zapier/Make, a Slack or Teams incoming webhook, ...
ENQUIRY_WEBHOOK_URL=

# Optional: shows a direct email address on the enquiry page when a visitor chooses "I have a question".
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Admin area (/admin): job openings and the enquiry inbox ---------------------------------------------------------
# The password for /admin. Without it the admin page says it is not set up. Use a long, random one.
ADMIN_PASSWORD=
# Optional: a separate secret for signing the admin login cookie (defaults to a value derived from ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Where job openings and enquiries are saved when the site is deployed (Vercel has no writable disk).
# Create a free Upstash Redis database (Vercel > Storage > Marketplace > Upstash Redis) and copy its REST URL and token here.
# The names KV_REST_API_URL / KV_REST_API_TOKEN that Vercel adds are understood as well.
# Locally, with neither set, everything is saved to .data/fen1.json instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
